<Window x:Class="SynapseXApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synapse X - The Revival"
        Height="560" Width="820"
        MinHeight="400" MinWidth="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BgBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>    <!-- Title bar -->
                <RowDefinition Height="3"/>     <!-- Orange accent line -->
                <RowDefinition Height="42"/>    <!-- Tab bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="28"/>    <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ========== TITLE BAR ========== -->
            <Grid Grid.Row="0" Background="#FF0D0D0D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="S" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Text="  Synapse X - The Revival" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock Grid.Column="1" Text="v2.0" FontSize="11" Foreground="#FF666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"/>
                    <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CloseButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ========== ORANGE ACCENT LINE ========== -->
            <Border Grid.Row="1" Background="{StaticResource AccentBrush}"/>

            <!-- ========== TAB BAR ========== -->
            <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TabExecute" Content="Execute" Style="{StaticResource TabButton}" Click="TabExecute_Click"/>
                    <Button x:Name="TabScriptHub" Content="Script Hub" Style="{StaticResource TabButton}" Click="TabScriptHub_Click"/>
                    <Button x:Name="TabSettings" Content="Settings" Style="{StaticResource TabButton}" Click="TabSettings_Click"/>
                </StackPanel>
            </Border>

            <!-- ========== CONTENT AREA ========== -->
            <Grid Grid.Row="3">

                <!-- EXECUTE TAB -->
                <Grid x:Name="ExecutePanel" Margin="16,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Script Editor -->
                    <Border Grid.Row="0" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource BgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Line Numbers -->
                            <Border Grid.Column="0" Background="#FF1A1A1A" Padding="8,8,4,8" MinWidth="40">
                                <TextBlock x:Name="LineNumbers" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF555555" TextAlignment="Right" Text="1"/>
                            </Border>

                            <!-- Editor -->
                            <TextBox x:Name="ScriptEditor" Grid.Column="1"
                                     FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     BorderThickness="0" Padding="8"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="ScriptEditor_TextChanged"
                                     Text="-- Paste or write your script here&#x0a;print(&quot;Hello World&quot;)"/>
                        </Grid>
                    </Border>

                    <!-- Button Bar -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Execute &#x25B6;" Style="{StaticResource AccentButton}"
                                Click="ExecuteButton_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource DarkButton}"
                                Click="ClearButton_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Open File" Style="{StaticResource DarkButton}"
                                Click="OpenFileButton_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Save File" Style="{StaticResource DarkButton}"
                                Click="SaveFileButton_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="5" Content="&#x26A1; Quick Launch" Style="{StaticResource AccentButton}"
                                Click="QuickLaunchButton_Click"/>
                    </Grid>
                </Grid>

                <!-- SCRIPT HUB TAB -->
                <Grid x:Name="ScriptHubPanel" Margin="16,12,16,8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Script Hub" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ScriptHubList"/>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS TAB -->
                <Grid x:Name="SettingsPanel" Margin="16,12,16,8" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

                            <!-- GitHub URL -->
                            <TextBlock Text="GitHub Raw URL" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="GitHubUrlBox" Style="{StaticResource DarkTextBox}"
                                     Text="https://raw.githubusercontent.com/pebbleford/roblox-scripts/main/synapsex.lua"
                                     Margin="0,0,0,16"/>

                            <!-- Loadstring Preview -->
                            <TextBlock Text="Loadstring Command" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="10,8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                                <TextBlock x:Name="LoadstringPreview" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                           Text="loadstring(game:HttpGet(&quot;https://raw.githubusercontent.com/pebbleford/roblox-scripts/main/synapsex.lua&quot;))()"/>
                            </Border>
                            <Button Content="Copy Loadstring" Style="{StaticResource AccentButton}"
                                    Click="CopyLoadstringButton_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                            <!-- Theme Info -->
                            <TextBlock Text="Theme" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="16" Height="16" CornerRadius="2" Background="#FF141414" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dark Theme" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text=" (Active)" Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="Background: #141414  |  Accent: #FF6600" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>

                            <!-- About -->
                            <TextBlock Text="About" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4">
                                        <Run Text="Synapse X - The Revival" FontWeight="SemiBold"/>
                                        <Run Text=" v2.0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Desktop Script Manager &amp; Launcher" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Companion app for the Synapse X Roblox GUI script." FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="GitHub: "/>
                                        <Run Text="pebbleford/roblox-scripts" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== STATUS BAR ========== -->
            <Border Grid.Row="4" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0"/>
            </Border>

            <!-- Resize Grip -->
            <ResizeGrip Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Foreground="#FF555555"/>
        </Grid>
    </Border>
</Window>
